# Example Secret — COPY and fill in real values, then:
#   kubectl apply -f deepthink-secret.yaml
# NEVER commit real secrets to git!

apiVersion: v1
kind: Secret
metadata:
  name: deepthink-secret
  namespace: deepthink
  labels:
    app.kubernetes.io/name: deepthink
type: Opaque
stringData:
  # Cookie/session signing secret (32+ bytes hex). Generate with:
  #   openssl rand -hex 32
  WEB_SESSION_SECRET: "CHANGE_ME_TO_RANDOM_64_HEX_CHARS"

  # Claude provider API key
  ANTHROPIC_API_KEY: "sk-ant-CHANGE_ME"

  # PostgreSQL credentials (multi-pod mode)
  PG_USER: "deepthink"
  PG_PASSWORD: "CHANGE_ME_STRONG_PASSWORD"
  DATABASE_URL: "postgresql://deepthink:CHANGE_ME_STRONG_PASSWORD@postgres:5432/deepthink"

  # MinIO / S3 credentials (object store + Litestream target)
  S3_ACCESS_KEY_ID: "deepthink"
  S3_SECRET_ACCESS_KEY: "CHANGE_ME_MINIO_SECRET"

  # ClickHouse credentials (optional analytics store)
  CLICKHOUSE_USER: "deepthink"
  CLICKHOUSE_PASSWORD: "CHANGE_ME_CLICKHOUSE_PASSWORD"

  # IM channel secrets (optional — only if using IM integrations)
  # FEISHU_APP_ID: "cli_xxx"
  # FEISHU_APP_SECRET: "xxx"
  # TELEGRAM_BOT_TOKEN: "xxx"
  # DISCORD_BOT_TOKEN: "xxx"
